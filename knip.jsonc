{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "playwright.config.ts",
        "vitest.config.ts",
        "vitest.ui.config.ts",
        "vitest.integration.config.ts",
        "scripts/*.mjs",
      ],
      "ignoreDependencies": ["cloudflare", "opencode-goal-plugin"],
    },
    "apps/web": {
      "entry": ["src/main.tsx", "vite.config.ts", "e2e/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "ignoreDependencies": ["tailwindcss"],
    },
    "apps/worker": {
      "entry": ["src/index.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/domain": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/testkit": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/ui": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
    },
  },
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off",
  },
}
