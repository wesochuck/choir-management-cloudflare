{
  "name": "choir-management-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "choir-deploy-production": "scripts/deploy-production-local.mjs",
    "choir-deploy-staging": "scripts/deploy-staging-local.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "audit": "npm audit --audit-level=high",
    "bootstrap:staging-platform-admin": "node scripts/bootstrap-staging-platform-admin.mjs",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run audit && npm run format:check && npm run lint && npm run knip && npm run check:spacing && npm run check:csp && npm run check:no-eyebrows && npm run typecheck && npm test && npm run build && npm run test:integration:prepared",
    "check:ci": "node scripts/check-ci.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:no-eyebrows": "node scripts/check-no-eyebrows.mjs",
    "check:parity:implementation": "node scripts/audit-parity-implementation.mjs",
    "check:contracts:exports": "node scripts/check-contract-exports.mjs",
    "check:do-runtime": "node scripts/check-do-runtime-boundaries.mjs",
    "check:parity": "node scripts/check-parity-matrix.mjs",
    "check:spacing": "node scripts/check-spacing.mjs",
    "deploy:production": "node scripts/deploy-production-local.mjs",
    "deploy:staging": "node scripts/deploy-staging-local.mjs",
    "qualify:staging": "node scripts/qualify-staging.mjs",
    "qualify:staging:auth": "node scripts/qualify-staging-auth.mjs",
    "qualify:staging:auth:login": "node scripts/qualify-staging-auth-login.mjs",
    "qualify:staging:evidence": "node scripts/qualify-staging-evidence.mjs",
    "qualify:staging:platform": "node scripts/qualify-staging-platform-login.mjs",
    "qualify:staging:identity": "node scripts/qualify-staging-identity.mjs",
    "qualify:staging:roster": "node scripts/qualify-staging-roster.mjs",
    "qualify:staging:roster-automation": "node scripts/qualify-staging-roster-automation.mjs",
    "qualify:staging:rsvp-attendance": "node scripts/qualify-staging-rsvp-attendance.mjs",
    "qualify:staging:provider-independent": "node scripts/qualify-staging-provider-independent.mjs",
    "qualify:staging:custom-domain": "node scripts/qualify-staging-custom-domain.mjs",
    "qualify:staging:export": "node scripts/qualify-staging-export.mjs",
    "qualify:staging:follow-up": "node scripts/qualify-staging-follow-up.mjs",
    "qualify:staging:all": "node scripts/qualify-staging-all.mjs",
    "qualify:staging:clear-cache": "node scripts/staging-auth-helper.mjs --clear-cache",
    "qualify:staging:scheduler": "node scripts/qualify-staging-scheduler.mjs",
    "qualify:staging:ticket-reminder": "node scripts/qualify-staging-ticket-reminder.mjs",
    "qualify:staging:stripe-commerce": "node scripts/qualify-staging-stripe-commerce.mjs",
    "qualify:staging:setup-maintenance": "node scripts/qualify-staging-setup-maintenance.mjs",
    "setup:env": "node scripts/setup-developer-environment.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --config apps/worker/wrangler.jsonc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache --cache-location .cache/eslint --cache-strategy content .",
    "knip": "knip --reporter compact",
    "release:artifact:create": "node scripts/release-artifact.mjs create",
    "release:artifact:verify": "node scripts/release-artifact.mjs verify",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test --config playwright.config.ts --project=chromium --project=mobile-chromium",
    "test:e2e:fullstack": "playwright test --config playwright.config.ts fullstack --project=chromium --project=mobile-chromium --workers=1",
    "test:e2e:webkit": "node scripts/run-e2e-webkit.mjs",
    "test:e2e:all-browsers": "playwright test --config playwright.config.ts --project=chromium --project=mobile-chromium --project=webkit-smoke",
    "test:integration": "npm run build -w @choir/web && npm run test:integration:prepared",
    "test:integration:prepared": "WRANGLER_LOG_PATH=.wrangler/logs vitest run --config vitest.integration.config.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "wrangler": "WRANGLER_LOG_PATH=.wrangler/logs wrangler"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260831.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "^29.1.1",
    "knip": "6.32.3",
    "prettier": "3.9.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.128.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true,
    "workerd@1.20260730.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "opencode-goal-plugin": "^0.6.5"
  }
}
